# Neo4j: lokale Instanz oder Aura
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Embeddings: Ollama oder OpenAI-kompatible Embedding-API
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=180

# Optional: LLM für Extraktion semantischer Entitäten und Beziehungen
# Ollama OpenAI-kompatibel z. B. http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=180
ENTITY_EXTRACTION_ENABLED=false
# Autonome Qualitätsprüfung für vorgeschlagene Beziehungen bei Graphanalysen.
# Nutzt LLM-Aufrufe nur, wenn offene Kandidaten vorhanden sind; Originalbelege werden validiert.
AUTONOMOUS_QUALITY_ENABLED=false
QUALITY_MAX_CANDIDATES_PER_RUN=20
QUALITY_BATCH_SIZE=5
QUALITY_MIN_CONFIDENCE=0.82

# Qualitaetsgesicherte Community-Summaries und optionaler Global Search
COMMUNITY_SUMMARIES_ENABLED=true
COMMUNITY_SUMMARY_MIN_MEMBERS=3
COMMUNITY_SUMMARY_MAX_PER_RUN=8
COMMUNITY_SUMMARY_BATCH_SIZE=2
GLOBAL_SEARCH_ENABLED=true

# Indexer
CHUNK_SIZE=1800
CHUNK_OVERLAP=220
# Für CPU-only mit nomic-embed-text zunächst 32; anhand echter Dokumente benchmarken.
EMBEDDING_BATCH_SIZE=32
# Maximal eingebettete Textabschnitte pro Datei. Überschüssige Chunks werden ausgelassen,
# aber auf dem KGFile mit needs_deep_analysis=true zur späteren Analyse markiert.
MAX_CHUNKS_PER_FILE=500
# Sicherheitslimit für GDS-Projektionen; schützt vor ungewollt großen In-Memory-Graphen.
GDS_MAX_ENTITY_NODES=50000
# Separates, konservativeres Limit für den potenziell aufwendigeren Node-Similarity-Algorithmus.
GDS_MAX_NODE_SIMILARITY_NODES=15000
# Maximaler Graph-Scope für die GDS-KNN-Berechnung von ähnlichen Textabschnitten
GDS_MAX_KNN_CHUNKS=10000
MAX_FILE_SIZE_MB=80
LOG_LEVEL=INFO

# Zusätzliche ausgeschlossene Verzeichnisnamen, mit Semikolon trennen
EXTRA_EXCLUDED_DIRS=
# Bei Bedarf bewusst auf true setzen, um typische Geheimnisdateien zu indexieren.
INCLUDE_SENSITIVE_FILES=false

# Optionale Nutzung von Docling für zusätzliche Dateiformate / bessere Layout-Extraktion
USE_DOCLING=false
