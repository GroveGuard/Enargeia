# User-facing installation: use the setup wizard; this file is for developers only.
# A new install defaults to local Neo4j + in-process FastEmbed, with optional LLM features off.
NEO4J_MODE=local
NEO4J_URI=neo4j://127.0.0.1:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_LOCAL_PORT=17687
GDS_ENABLED=true

# fastembed is in-process. Model files download to the user cache on first embedding use.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=180
EMBEDDING_THREADS=0
EMBEDDING_BATCH_SIZE=32

# LLM is independent of embedding provider. Set provider none, ollama, or openai-compatible.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
ENTITY_EXTRACTION_ENABLED=false
AUTONOMOUS_QUALITY_ENABLED=false
COMMUNITY_SUMMARIES_ENABLED=false
GLOBAL_SEARCH_ENABLED=false
QUALITY_MAX_CANDIDATES_PER_RUN=20
QUALITY_BATCH_SIZE=5
QUALITY_MIN_CONFIDENCE=0.82
COMMUNITY_SUMMARY_MIN_MEMBERS=3
COMMUNITY_SUMMARY_MAX_PER_RUN=8
COMMUNITY_SUMMARY_BATCH_SIZE=2

# Indexer
CHUNK_SIZE=1800
CHUNK_OVERLAP=220
MAX_CHUNKS_PER_FILE=500
MAX_FILE_SIZE_MB=80
GDS_MAX_ENTITY_NODES=50000
GDS_MAX_NODE_SIMILARITY_NODES=15000
GDS_MAX_KNN_CHUNKS=10000
LOG_LEVEL=INFO
EXTRA_EXCLUDED_DIRS=
INCLUDE_SENSITIVE_FILES=false
INCLUDE_IGNORED_DIRS=false
USE_DOCLING=false
